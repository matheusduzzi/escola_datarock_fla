{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pedido": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "enviado",
        "entregue"
      ]
    },
    "prazo_dias": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30
    },
    "fonte": {
      "type": "string",
      "enum": [
        "politica-v1"
      ]
    }
  },
  "required": [
    "pedido",
    "status",
    "prazo_dias",
    "fonte"
  ],
  "additionalProperties": false
}
